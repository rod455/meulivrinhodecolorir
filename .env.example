# Copie para .env.local no desenvolvimento. Na produção, tudo isto mora na Vercel.
# Nenhuma chave entra no git.

# Dados públicos do negócio (aparecem no rodapé, na privacidade e no WhatsApp)
NEXT_PUBLIC_WHATSAPP=          # só dígitos, com 55 e DDD: 5511912345678
NEXT_PUBLIC_EMAIL_CONTATO=
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_RAZAO_SOCIAL=

# Medição (seção 9)
NEXT_PUBLIC_GA_ID=             # G-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Login: endereço e chave anon do Supabase. Opcionais; sem eles vale o projeto
# padrão em lib/config.ts (são públicos, vão para o navegador de qualquer jeito).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Onde o pedido fica guardado. Precisa de pelo menos UM, senão a rota recusa o pedido.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_PEDIDO=

# A foto da criança para o personagem só aparece no formulário com o Supabase ligado
# (bucket privado `fotos-criancas`, migração 0002). Mudou aqui, faça um novo deploy.
# A limpeza diária das fotos vencidas (vercel.json) só roda com este segredo:
CRON_SECRET=

# A ficha do personagem: o webhook do fluxo "Meu Livrinho: gerar ficha" no n8n.
# Sem ele, a etapa "Conheça o personagem" avisa que abre em breve e ninguém paga.
N8N_WEBHOOK_FICHA=

# Os livros da turma (impresso R$ 79,90 e PDF R$ 29,90): o aviso de pedido novo
# para o dono (fluxo "Meu Livrinho | pedido da turma") e um link de pagamento por
# formato. Sem link, o pedido fica registrado e o dono cobra pelo WhatsApp.
N8N_WEBHOOK_TURMA=
# fluxo "Meu Livrinho | escrever história": a IA escreve a história sob medida (sem o nome da criança)
N8N_WEBHOOK_HISTORIA=https://n8n.vocaboost.com.br/webhook/meu-livrinho-historia
PAGAMENTO_LINK_TURMA_IMPRESSO=
PAGAMENTO_LINK_TURMA_PDF=

# Link de pagamento por produto e forma (Mercado Pago ou Stripe Payment Link).
# O link do Pix tem que estar com 5% de desconto. Sem link, o pedido é registrado
# e a página de obrigado avisa que o link chega pelo WhatsApp.
PAGAMENTO_LINK_LEMBRANCINHA_PIX=
PAGAMENTO_LINK_LEMBRANCINHA_CARTAO=
PAGAMENTO_LINK_PRESENTE_PIX=
PAGAMENTO_LINK_PRESENTE_CARTAO=
PAGAMENTO_LINK_COMBO_PIX=
PAGAMENTO_LINK_COMBO_CARTAO=
# a história sob medida (R$ 39,90); o hífen do produto vira _ no nome da variável
PAGAMENTO_LINK_SOB_MEDIDA_PIX=
PAGAMENTO_LINK_SOB_MEDIDA_CARTAO=
